# SMTP Configuration for email sending
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=micim@micim.fr

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-09
# Write token, used only by scripts/migrate-to-sanity.ts. Never expose client-side.
SANITY_API_WRITE_TOKEN=
# Shared secret configured on the Sanity webhook, used to verify app/api/revalidate requests.
SANITY_REVALIDATE_SECRET=